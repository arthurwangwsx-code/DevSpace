{
  "manifest_version": 3,
  "name": "DevSpace Browser Bridge",
  "version": "0.3.0",
  "key": "",
  "description": "Lets DevSpace agents use explicitly acquired tabs in your signed-in Chrome profile.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "debugger", "nativeMessaging", "storage", "alarms", "downloads", "webNavigation", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
